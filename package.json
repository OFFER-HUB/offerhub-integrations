{
  "name": "offerhub-integrations",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source integration packages behind OfferHub: Trustless Work and BlindPay adapters for NestJS, the production validation runner and its API client",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @offerhub/sdk -w @offerhub-orchestrator/adapter-trustlesswork -w @offerhub-orchestrator/adapter-blindpay -w @offerhub/validator",
    "test": "jest",
    "validate": "tsx --tsconfig tsconfig.base.json packages/validator/src/cli.ts",
    "validation:results": "tsx --tsconfig tsconfig.base.json packages/validator/src/results-cli.ts",
    "check:blank-project": "node scripts/check-blank-project.mjs"
  },
  "devDependencies": {
    "@nestjs/common": "^10.4.5",
    "@nestjs/core": "^10.4.5",
    "@nestjs/testing": "^10.4.5",
    "@stellar/stellar-sdk": "^14.4.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.11.30",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.0",
    "jest": "^30.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ts-jest": "^29.4.6",
    "tsx": "^4.7.2",
    "typescript": "^5.9.3"
  }
}
