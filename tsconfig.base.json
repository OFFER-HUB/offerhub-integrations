{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@offerhub/sdk": [
        "packages/sdk/src/index.ts"
      ],
      "@offerhub-orchestrator/adapter-trustlesswork": [
        "packages/adapter-trustlesswork/src/index.ts"
      ],
      "@offerhub-orchestrator/adapter-blindpay": [
        "packages/adapter-blindpay/src/index.ts"
      ]
    },
    "outDir": "dist"
  }
}
